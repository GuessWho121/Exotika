FROM node:20-alpine

RUN apk add --no-cache openssl libc6-compat

WORKDIR /usr/src/app

COPY package*.json ./

RUN npm install

COPY . .

# Set permissions for node user
RUN chown -R node:node /usr/src/app

# Switch to non-root user
USER node

# Generate Prisma Client
RUN npx prisma generate

EXPOSE 8080

CMD ["npm", "run", "dev"]
