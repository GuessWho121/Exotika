# Application Configuration
PORT=8080
NODE_ENV=development
JWT_SECRET=CHANGE_ME_TO_A_COMPLEX_32_CHAR_SECRET_KEY
CORS_ORIGIN=http://localhost:5173

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/exotika_db?schema=public&connection_limit=10"

# MinIO / S3 Object Storage Configuration
S3_ENDPOINT="http://localhost:9000"
S3_PUBLIC_URL="http://localhost:9000"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_S3_BUCKET_NAME="exotika-bucket"
S3_FORCE_PATH_STYLE=true
COOKIE_DOMAIN=

# Razorpay sandbox settings (true in dev, must be false in production)
RAZORPAY_SANDBOX=true
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Shiprocket sandbox settings (true in dev, must be false in production)
SHIPROCKET_SANDBOX=true
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_POSTCODE=
SHIPROCKET_PICKUP_LOCATION_NAME=

